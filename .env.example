# Names only. Values live in Doppler (project promptarmor, config prd):
#   doppler run -p promptarmor -c prd -- bun run dev
# Never put secret values in this file.

# Supabase (new API keys only: sb_publishable_ / sb_secret_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Nango Cloud
NANGO_SECRET_KEY=
NANGO_WEBHOOK_SIGNING_KEY=

# Optional: fallback public origin when it can't be derived from the request
NEXT_PUBLIC_SITE_URL=

# Vercel Cron auth for /api/cron/maintenance (sent as "Authorization: Bearer ...").
# Without it the maintenance route refuses every call.
CRON_SECRET=

# Derived in next.config.ts from SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY.
# Set them directly only to override:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway (lib/ai). On Vercel the gateway authenticates automatically
# (OIDC); locally `@vercel/oidc` refreshes a token from the Vercel CLI login and
# .vercel/project.json. Set a key only when neither is available.
# AI_GATEWAY_API_KEY=

# AI spend policy (docs/ai-policy.md).
# AI_MODE: live | off | replay
#   live    model calls allowed (budget reserved and settled around each one)
#   off     never calls a model; checks complete with the deterministic
#           findings only (product terms, hidden text) and say so
#   replay  never calls a model; uses fixtures/recorded/*.json when the ad's
#           text matches a recording, else behaves like off
# Unset: live when VERCEL_ENV=production, off everywhere else (local, preview).
# AI_MODE=
# AI_CHECK_MODEL: gateway model id for the ad check. Unset = anthropic/claude-haiku-5.5
# (the cheapest capable model). Opus ids are refused. Classification, transcription
# and "Ask about this ad" always use Haiku.
# AI_CHECK_MODEL=
